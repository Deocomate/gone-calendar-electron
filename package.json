{
  "name": "gone-calendar",
  "version": "0.1.0",
  "description": "Desktop Calendar for Windows and Linux with modern UX and multi-provider sync",
  "private": true,
  "author": "Gone Calendar Team",
  "homepage": "https://github.com/Deocomate/gone-calendar-electron#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deocomate/gone-calendar-electron.git"
  },
  "bugs": {
    "url": "https://github.com/Deocomate/gone-calendar-electron/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "clean": "rm -rf out dist *.tsbuildinfo",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "app:install": "bash scripts/install-linux-app.sh",
    "app:update": "bash scripts/install-linux-app.sh"
  },
  "dependencies": {
    "i18next": "^24.2.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.16.0",
    "luxon": "^3.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "rrule": "^2.8.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.9",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.8"
  }
}
