# Editor defaults matching the conventions already used across this repo:
# two-space indentation, LF endings, single quotes, no semicolons.
# Advisory only - there is no formatter wired into the build.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
